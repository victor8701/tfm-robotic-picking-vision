# Regenerable desde el parquet cacheado (~/.cache/fashion-product-images-small/)
# + preparar_dataset_florence2.py con la misma semilla -- no hace falta
# subir varios cientos de imagenes binarias al repo.
data/imagenes_cache/

# Adapters intermedios/experimentales que no sean el final documentado.
modelos/*/checkpoint-*/

# Fotos de personas identificables (Wikimedia Commons, street fashion): la licencia
# permite redistribuirlas pero no hace falta; se regeneran con
# herramientas/descargar_fotos_calle_wikimedia.py (ATRIBUCIONES.txt si se quiere citar).
data/fotos_calle/**/*.jpg
